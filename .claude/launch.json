{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backpy-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backpy-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "backpy-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--base=/backpy-dev/",
        "--outDir",
        "dist-pages",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    }
  ]
}
